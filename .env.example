# 复制为 .env 后填写；程序读取进程环境变量（export 或 set -a; source .env）。不要提交 .env
# 云端 LLM（任选）
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
XAI_API_KEY=
XAI_MODEL=
# 通用 OpenAI 兼容接口（不传 --provider 时生效；默认本地 Ollama）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=
# RAG 行为
RAG_PROMPT=
RAG_EXPAND=
RAG_REFUSE_BELOW=
# 其它
OCR_ENGINE=
PADDLE_PY=
HF_HOME=
EVAL_RULES=

# 跨语言检索：none|dict|llm|cap（云端 provider 默认 cap，本地默认 none）
RAG_XLANG=

# API 服务（api.py）
KB_API_TOKEN=
KB_API_URL=http://127.0.0.1:8000
KB_CORS_ORIGINS=
KB_MAX_UPLOAD_MB=50
KB_MAX_CONCURRENCY=2
