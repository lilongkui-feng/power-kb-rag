# ===== 敏感信息：只能放这里（.env）或环境变量，禁止写进 config.yaml =====
# cp .env.example .env 后填写；.env 已在 .gitignore 中。留空 = 未设置。
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
LLM_API_KEY=
# 非空即开启 API 鉴权（Authorization: Bearer <token> 或 X-API-Key）；前端进程设置同一个值
KB_API_TOKEN=
MILVUS_TOKEN=

# ===== 以下为可选覆盖（也可写在 config.yaml；这里的值优先级更高）=====
# 完整列表与默认值见 config.example.yaml；查看生效配置：python config.py
CONFIG_FILE=
LOG_LEVEL=
LOG_FORMAT=
SILICONFLOW_MODEL=
LLM_BASE_URL=
LLM_MODEL=
LLM_FALLBACK=
VECTOR_STORE=
MILVUS_URI=
HF_HOME=
HF_ENDPOINT=
KB_API_URL=

# ===== docker compose 变量（留空用默认）=====
KB_DATA_DIR=
POWER_DOCS_DIR=
HF_CACHE_DIR=
OLLAMA_MODELS_DIR=
OLLAMA_MODEL=
KB_API_PORT=
KB_WEB_PORT=
# 端口绑定地址：0.0.0.0（默认，公网可直连）| 127.0.0.1（只让本机 Nginx 访问，配合 HTTPS 时推荐）
KB_BIND=
# 构建镜像时的 pip 源（国内可填 https://mirrors.aliyun.com/pypi/simple/）与 torch CPU wheel 源
PIP_MIRROR=
TORCH_INDEX_URL=
