# ===== 敏感信息：只能放这里（.env）或环境变量，禁止写进 config.yaml =====
# cp .env.example .env 后填写；.env 已在 .gitignore 中。留空 = 未设置。
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
LLM_API_KEY=
# 非空即开启 API 鉴权（Authorization: Bearer <token> 或 X-API-Key）；前端进程设置同一个值
KB_API_TOKEN=
MILVUS_TOKEN=

# ===== 以下为可选覆盖（也可写在 config.yaml；这里的值优先级更高）=====
# 完整列表与默认值见 config.example.yaml；查看生效配置：python config.py
CONFIG_FILE=
LOG_LEVEL=
LOG_FORMAT=
SILICONFLOW_MODEL=
# 自定义 / OpenAI 兼容网关（provider=custom）：LLM_BASE_URL + LLM_MODEL + 上面的 LLM_API_KEY；非空时 provider 留空也默认走它
LLM_BASE_URL=
LLM_MODEL=
# provider=local 的地址与模型（compose 默认 http://ollama:11434/v1 与 OLLAMA_MODEL）
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
# 前端：false = 关闭流式，一律用 /ask 一次性返回（浏览器↔服务器链路不稳时）；流式中断会自动回退
KB_STREAMING=
KB_STREAM_IDLE_TIMEOUT=
LLM_FALLBACK=
VECTOR_STORE=
MILVUS_URI=
HF_HOME=
HF_ENDPOINT=
KB_API_URL=

# ===== docker compose 变量（留空用默认）=====
# 启用的 profile：ollama = 启动本地 ollama 容器（默认）；只用网关/云端时留空；需要 Milvus 再加 ,milvus
COMPOSE_PROFILES=ollama
KB_DATA_DIR=
POWER_DOCS_DIR=
HF_CACHE_DIR=
OLLAMA_MODELS_DIR=
OLLAMA_MODEL=
KB_API_PORT=
KB_WEB_PORT=
# 端口绑定地址：0.0.0.0（默认，公网可直连）| 127.0.0.1（只让本机 Nginx 访问，配合 HTTPS 时推荐）
KB_BIND=
# 构建镜像时的源（作为 build args 传入 Dockerfile，对 torch 行和依赖行都生效）：
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/   （PIP_MIRROR 为旧名，仍兼容）
#   TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu     （留空用默认；torch 的依赖会从 PIP_INDEX_URL 拉）
#   APT_MIRROR=mirrors.aliyun.com                            （Debian apt 镜像主机名）
PIP_INDEX_URL=
PIP_MIRROR=
PIP_EXTRA_INDEX_URL=
TORCH_INDEX_URL=
APT_MIRROR=
